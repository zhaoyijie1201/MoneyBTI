      "small_txn_ratio": "K7 金额<=20 的笔数占比",
      "top_category_share": "K4 最大类别金额占比",
      "median_amount": "K8 金额中位数",
      "big_ticket_share": "K9 金额>=200 合计占比",
      "online_share": "K10 线上金额占比",
      "shopping_share": "C5+C6 金额占比",
