{
  "_meta": {
    "version": "3.0",
    "date": "2026-09-08",
    "description": "MoneyBTI 钱格 人格卡知识库 v3。16 张常规卡 (group=regular) 用 signature（维度原型 + 权重 + 门槛）在 11 维消费维度空间里做原型匹配：原型 ≥ 50 的维度是「应当高」，sat = 1 − max(0, proto − score)/50；原型 < 50 的维度是「不应高」，sat = 1 − max(0, score − proto)/100；match = 100 × Σ w·sat / Σ w，门槛不满足封顶 40，match ≥ 70 记命中。trigger 字段保留为 v1 阈值规则（评估对照变体）。7 张特别卡 (special / fallback) 仍用 trigger 阈值：成就卡描述事件而非维度，命中即 override。",
    "rarity_levels": {
      "常见": "≈ 30% 以上账单会命中",
      "少见": "≈ 10–30%",
      "稀有": "≈ 2–10%",
      "传说": "< 2%"
    },
    "metric_glossary": {
      "food_share": "K5 (C1+C2+C4)/total",
      "delivery_ratio": "K6 C1/(C1+C2+C3)",
      "beverage_per_week": "K12 C4 笔数/周数",
      "C2_share / C3_share / C4_share / C6_share / C9_share / C10_share": "K3 各类别金额占比",
      "distinct_C2_merchants": "C2 中不同商户数",
      "game_share": "C8 金额中排除票务旅游家族 (M15) 后的占比",
      "travel_share": "票务旅游家族 (M15) 金额占比",
      "subscription_brands": "视频音乐订阅家族 (M14) 命中的不同商户数 + 说明含 会员/订阅 的不同商户数",
